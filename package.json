{
  "name": "@fintlp/openclaw-meshcore",
  "version": "2026.10.14",
  "description": "An AI agent on your mesh: OpenClaw channel plugin for MeshCore LoRa nodes (Companion Protocol over TCP).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fintlp/openclaw-meshcore.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**",
    "assets/icon.png",
    "openclaw.plugin.json",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync-manifest": "tsx scripts/sync-manifest.ts",
    "prepack": "npm run sync-manifest && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@liamcottle/meshcore.js": "1.15.0",
    "@noble/curves": "1.9.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "openclaw": "2026.10.5",
    "tsdown": "0.22.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "meshcore",
      "label": "MeshCore",
      "selectionLabel": "MeshCore (TCP)",
      "docsPath": "/channels/meshcore",
      "docsLabel": "meshcore",
      "blurb": "LoRa mesh messaging via MeshCore Companion Protocol over TCP.",
      "order": 69,
      "quickstartAllowFrom": true,
      "cliAddOptions": [
        {
          "flags": "--host <host>",
          "description": "MeshCore node host or IP (optionally host:5000)"
        },
        {
          "flags": "--dm-policy <policy>",
          "description": "pairing (default), allowlist, open, or disabled"
        }
      ]
    },
    "install": {
      "npmSpec": "@fintlp/openclaw-meshcore",
      "clawhubSpec": "@fintlp/openclaw-meshcore",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.10.5"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  },
  "homepage": "https://github.com/fintlp/openclaw-meshcore#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "meshcore",
    "lora",
    "mesh",
    "mesh-network",
    "radio",
    "off-grid",
    "chat",
    "channel-plugin"
  ]
}
