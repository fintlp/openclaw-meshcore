{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["./*.ts", "./src/**/*.ts", "./src/**/*.d.ts"],
  "exclude": ["./**/*.test.ts", "./dist/**", "./node_modules/**"]
}
